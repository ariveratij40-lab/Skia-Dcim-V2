FROM golang:1.25-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod ./
RUN go mod download
COPY . .
RUN go mod tidy
RUN go test -v -cover -coverprofile=coverage.out -timeout 60s ./... 2>&1 | tee /test-results.txt || true
RUN go tool cover -func=coverage.out > /coverage-report.txt 2>&1 || true
RUN go build -o skia-api .

FROM alpine:latest
WORKDIR /app
RUN apk add --no-cache ca-certificates wget python3 py3-pip
RUN pip3 install --no-cache-dir --break-system-packages pdfplumber
COPY --from=builder /app/skia-api .
COPY --from=builder /test-results.txt /test-results.txt
COPY --from=builder /coverage-report.txt /coverage-report.txt
EXPOSE 8080
CMD ["./skia-api"]
