FROM golang:1.25-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod ./
RUN go mod download
COPY . .
RUN go mod tidy

# gofmt
RUN gofmt -w . && echo ✓ gofmt OK

# go vet
RUN go vet ./... && echo ✓ go vet OK

# go test
RUN go test -count=1 ./... 2>&1 | tee /test-results.txt && echo ✓ go test OK

# go test -race
RUN go test -race -count=1 ./... 2>&1 | tee /test-race-results.txt && echo ✓ go test -race OK

# go test -coverprofile
RUN go test -count=1 -coverprofile=coverage.out ./... 2>&1 && go tool cover -func=coverage.out > /coverage-report.txt 2>&1 && echo ✓ coverage OK

# go build
RUN go build -o skia-api . && echo ✓ go build OK

FROM alpine:latest
WORKDIR /app
RUN apk add --no-cache ca-certificates wget python3 py3-pip
RUN pip3 install --no-cache-dir --break-system-packages pdfplumber
COPY --from=builder /app/skia-api .
COPY --from=builder /test-results.txt /test-results.txt
COPY --from=builder /test-race-results.txt /test-race-results.txt
COPY --from=builder /coverage-report.txt /coverage-report.txt
EXPOSE 8080
CMD ["./skia-api"]
